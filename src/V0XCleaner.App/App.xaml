<Application x:Class="V0XCleaner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:V0XCleaner.App"
             xmlns:helpers="clr-namespace:V0XCleaner.App.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

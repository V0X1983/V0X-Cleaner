<Window x:Class="V0XCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:V0XCleaner.App.ViewModels"
        xmlns:views="clr-namespace:V0XCleaner.App.Views"
        mc:Ignorable="d"
        Title="V0X Cleaner" Height="640" Width="1000"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CleanerPageViewModel}">
            <views:CleanerPageView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RegistryPageViewModel}">
            <views:RegistryPageView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToolsPageViewModel}">
            <views:ToolsPageView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OptionsViewModel}">
            <views:OptionsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <StackPanel Margin="32" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Margin="0,0,0,12" />
                <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{StaticResource BrushTextSecondary}"
                           TextWrapping="Wrap" LineHeight="20" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu latéral -->
        <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock Text="V0X Cleaner" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" />
                    <TextBlock Text="v0.1.0" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12,0,12,16" Padding="12,10" CornerRadius="8"
                        Background="{StaticResource BrushSurfaceAlt}">
                    <StackPanel>
                        <TextBlock Text="{Binding ElevationStatusLabel}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                        <Button Content="Relancer en administrateur" Margin="0,8,0,0" Padding="8,4" FontSize="11"
                                Command="{Binding RelaunchElevatedCommand}"
                                Visibility="{Binding IsElevated, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         Margin="0,8,0,0"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,2" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" Background="Transparent" CornerRadius="6">
                                            <ContentPresenter Margin="16,0" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                            <TextBlock Text="{Binding Title}" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Contenu de la page sélectionnée -->
        <Border Grid.Column="1" Background="{StaticResource BrushBackground}">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
    </Grid>
</Window>

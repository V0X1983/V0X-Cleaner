<UserControl xmlns:controls="clr-namespace:V0XCleaner.App.Controls"
             x:Class="V0XCleaner.App.Views.SoftwareUpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:V0XCleaner.App.ViewModels">
    <Grid>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Mise à jour de logiciels" FontSize="24" FontWeight="Bold" />
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Recherche et installe les mises à jour de vos applications via winget (inclus dans Windows 11)." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Analyser" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ScanCommand}" MinWidth="110" Margin="0,0,12,0" />
            <Button Content="Tout mettre à jour" Command="{Binding UpdateAllCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Updates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SoftwareUpdateItemViewModel}">
                        <Border Background="{StaticResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="Mettre à jour" Padding="8,3" FontSize="11" VerticalAlignment="Center"
                                        Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" IsEnabled="{Binding CanUpdate}" />
                                <Button DockPanel.Dock="Right" Content="&#xE774;" FontFamily="Segoe MDL2 Assets" Padding="8,3" FontSize="12"
                                        VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Ouvrir le site web de l'éditeur"
                                        Command="{Binding DataContext.OpenWebsiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" VerticalAlignment="Center" MaxWidth="150" Margin="8,0"
                                           Foreground="{StaticResource BrushAccent}" TextTrimming="CharacterEllipsis" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" VerticalAlignment="Center" Width="140" Margin="8,0"
                                           Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,16,0,0" TextWrapping="Wrap" />
    </Grid>
    <controls:LoadingOverlay DataContext="{Binding Loading}" />
    </Grid>
</UserControl>

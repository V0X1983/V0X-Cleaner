<UserControl xmlns:controls="clr-namespace:V0XCleaner.App.Controls"
             x:Class="V0XCleaner.App.Views.SoftwareUpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:V0XCleaner.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Mise à jour de logiciels" FontSize="24" FontWeight="Bold" />
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Recherche et installe les mises à jour de vos applications via winget (inclus dans Windows 11)." />
        </StackPanel>

        <!-- Titre de synthèse, affiché après une analyse qui a trouvé des mises à jour -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16" Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding HeadlineCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" />
                <TextBlock Text=" sont prêtes pour vous" FontSize="22" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Tenez vos logiciels à jour pour en améliorer la vitesse, les performances et la sécurité." />
        </StackPanel>

        <!-- En-têtes de colonnes -->
        <Grid Grid.Row="2" Margin="12,0,29,8" Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" IsThreeState="True" IsChecked="{Binding AllSelected}" VerticalAlignment="Center"
                      ToolTip="Tout sélectionner" />
            <TextBlock Grid.Column="1" Text="Logiciels" Foreground="{StaticResource BrushTextSecondary}" />
            <TextBlock Grid.Column="2" Text="Version actuelle" Foreground="{StaticResource BrushTextSecondary}" />
            <TextBlock Grid.Column="3" Text="Nouvelle version" Foreground="{StaticResource BrushTextSecondary}" />
            <TextBlock Grid.Column="4" Text="État" Foreground="{StaticResource BrushTextSecondary}" />
                    </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Updates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SoftwareUpdateItemViewModel}">
                        <Border Background="{StaticResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanUpdate}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding Name}" />
                                <TextBlock Grid.Column="2" Text="{Binding CurrentVersion}" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="3" Text="{Binding AvailableVersion}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Status}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRestartRequired}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ProgressBar Height="4" Margin="0,4,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                                                 Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushBorder}"
                                                 BorderThickness="0"
                                                 Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="&#xE774;" FontFamily="Segoe MDL2 Assets" Padding="8,3" FontSize="12"
                                            VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Ouvrir le site web de l'éditeur"
                                            Command="{Binding DataContext.OpenWebsiteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Mettre à jour" Padding="8,3" FontSize="11" VerticalAlignment="Center"
                                            Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding CanUpdate}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Barre du bas : message d'état à gauche, sélection et actions à droite -->
        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"
                           Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Analyser" Command="{Binding ScanCommand}" MinWidth="110" Margin="0,0,12,0" />
                <Button Content="Mettre à jour la sélection" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding UpdateSelectedCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
    <controls:LoadingOverlay DataContext="{Binding Loading}" />
    </Grid>
</UserControl>

<UserControl x:Class="V0XCleaner.App.Views.SystemRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:V0XCleaner.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Restauration système" FontSize="24" FontWeight="Bold" />
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Liste, crée et supprime des points de restauration Windows. Nécessite que la protection du système soit activée." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Actualiser" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RefreshCommand}" MinWidth="110" Margin="0,0,12,0" />

            <TextBox Grid.Column="1" Text="{Binding NewRestorePointDescription, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="8,4"
                     Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}" Margin="0,0,12,0" />

            <Button Grid.Column="2" Content="Créer un point de restauration" Padding="12,6" Command="{Binding CreateCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding RestorePoints}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RestorePointViewModel}">
                        <Border Background="{StaticResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding FormattedCreationTime}" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                                <Button Grid.Column="2" Content="Supprimer" Padding="8,3" FontSize="11"
                                        Click="DeleteButton_Click" Tag="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,16,0,0" />
    </Grid>
</UserControl>

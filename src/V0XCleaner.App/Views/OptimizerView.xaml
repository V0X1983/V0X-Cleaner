<UserControl x:Class="V0XCleaner.App.Views.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:V0XCleaner.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Point d'impact : allumé (orange) ; les variantes éteintes sont gérées par des déclencheurs -->
        <Style x:Key="ImpactDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Fill" Value="{StaticResource BrushWarning}" />
        </Style>

        <DataTemplate x:Key="ImpactTemplate" DataType="{x:Type vm:ProcessItemViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource ImpactDot}" />
                <Ellipse>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse" BasedOn="{StaticResource ImpactDot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Dot2On}" Value="False">
                                    <Setter Property="Fill" Value="{StaticResource BrushBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Ellipse>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse" BasedOn="{StaticResource ImpactDot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Dot3On}" Value="False">
                                    <Setter Property="Fill" Value="{StaticResource BrushBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ImpactText}" Margin="8,0,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Optimiseur de performances" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <RadioButton Style="{StaticResource TabStyle}" GroupName="optimizerTabs" Content="{Binding ActiveTabTitle}" IsChecked="{Binding IsActiveTab}" />
            <RadioButton Style="{StaticResource TabStyle}" GroupName="optimizerTabs" Content="{Binding SleepingTabTitle}" IsChecked="{Binding IsSleepingTab}" />
            <RadioButton Style="{StaticResource TabStyle}" GroupName="optimizerTabs" Content="{Binding ExcludedTabTitle}" IsChecked="{Binding IsExcludedTab}" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,20,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding HeadlinePrefix}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="{Binding HeadlineCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" />
                    <TextBlock Text="{Binding HeadlineSuffix}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
                <TextBlock Text="{Binding HeadlineDescription}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- En-têtes de colonnes -->
        <Grid Grid.Row="3" Margin="12,0,29,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Foreground="{StaticResource BrushTextSecondary}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Toutes les applications actives" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSleepingTab}" Value="True">
                                <Setter Property="Text" Value="Applications en veille" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsExcludedTab}" Value="True">
                                <Setter Property="Text" Value="Applications exclues" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" Text="Mémoire" HorizontalAlignment="Right" Foreground="{StaticResource BrushTextSecondary}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExcludedTab}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="2" Text="Impact sur les performances" Margin="24,0,0,0" Foreground="{StaticResource BrushTextSecondary}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExcludedTab}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="4">
            <!-- Onglet « actives » -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsActiveTab, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Processes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProcessItemViewModel}">
                            <Border Background="{StaticResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="2" Margin="24,0,0,0" Content="{Binding}" ContentTemplate="{StaticResource ImpactTemplate}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Mettre en veille" Padding="8,3" FontSize="11" Margin="0,0,8,0"
                                                Command="{Binding DataContext.SleepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Padding="8,3" FontSize="12"
                                                ToolTip="Plus d'actions" Click="MoreButton_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Onglet « en veille » -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSleepingTab, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Sleeping}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProcessItemViewModel}">
                            <Border Background="{StaticResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="2" Margin="24,0,0,0" Content="{Binding}" ContentTemplate="{StaticResource ImpactTemplate}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Réactiver" Padding="8,3" FontSize="11" Margin="0,0,8,0"
                                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Padding="8,3" FontSize="12"
                                                ToolTip="Plus d'actions" Click="MoreButton_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Onglet « exclues » -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsExcludedTab, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Excluded}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExcludedProcessViewModel}">
                            <Border Background="{StaticResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Réinclure" Padding="8,3" FontSize="11" VerticalAlignment="Center"
                                            Command="{Binding DataContext.IncludeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Barre du bas -->
        <Border Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushBorder}" Margin="0,16,0,0" Padding="0,16,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastAnalysisText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="Libérer la RAM" Command="{Binding FreeMemoryCommand}" Margin="0,0,12,0" />
                    <Button Content="Analyser à nouveau" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

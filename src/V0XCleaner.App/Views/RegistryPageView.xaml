<UserControl xmlns:controls="clr-namespace:V0XCleaner.App.Controls"
             x:Class="V0XCleaner.App.Views.RegistryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:V0XCleaner.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Registre" FontSize="24" FontWeight="Bold" />
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Recherche les entrées de registre orphelines. Une sauvegarde .reg est créée automatiquement avant toute réparation. Certaines réparations (clés HKEY_LOCAL_MACHINE) peuvent nécessiter de lancer V0X Cleaner en tant qu'administrateur." />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource BrushSurface}" CornerRadius="6" Padding="12" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Sauvegardes registre :" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,12,0" />

                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableBackups}"
                          SelectedItem="{Binding SelectedBackup}" VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FilePathToFileNameConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="2" Content="Restaurer" Click="RestoreButton_Click"
                        Padding="14,6" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- En-têtes de colonnes -->
        <Grid Grid.Row="2" Margin="12,0,29,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Catégorie" Foreground="{StaticResource BrushTextSecondary}" />
            <TextBlock Grid.Column="2" Text="Éléments" HorizontalAlignment="Right" Foreground="{StaticResource BrushTextSecondary}" />
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CleaningSectionViewModel}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccent}" Margin="12,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CleaningTaskViewModel}">
                                        <Border Background="{StaticResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextSecondary}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding LastError}" Foreground="{StaticResource BrushDanger}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding LastError, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Text="{Binding FoundItemsCount, StringFormat='{}{0} élément(s)'}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Barre du bas : état et problèmes trouvés à gauche, actions à droite -->
        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushBorder}" Margin="0,16,0,0" Padding="0,16,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Mode simulation (aperçu sans modification)" IsChecked="{Binding SimulationMode}"
                              VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{StaticResource BrushTextSecondary}" />
                    <Button Content="Analyser" Command="{Binding AnalyzeCommand}" MinWidth="110" Margin="0,0,12,0" />
                    <Button Content="Réparer" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanRepairNow}"
                            Click="RepairButton_Click" MinWidth="120" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalIssuesFound, StringFormat='Problèmes trouvés : {0}'}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
    <controls:LoadingOverlay DataContext="{Binding Loading}" />
    </Grid>
</UserControl>

<UserControl x:Class="V0XCleaner.App.Views.ToolsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:V0XCleaner.App.ViewModels"
             xmlns:views="clr-namespace:V0XCleaner.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:StartupManagerViewModel}">
            <views:StartupManagerView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UninstallManagerViewModel}">
            <views:UninstallManagerView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DiskAnalyzerViewModel}">
            <views:DiskAnalyzerView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DuplicateFinderViewModel}">
            <views:DuplicateFinderView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DriveWiperViewModel}">
            <views:DriveWiperView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SystemRestoreViewModel}">
            <views:SystemRestoreView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
            <views:QuarantineView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SoftwareUpdatesViewModel}">
            <views:SoftwareUpdatesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DriversViewModel}">
            <views:DriversView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OptimizerViewModel}">
            <views:OptimizerView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,24">
                <TextBlock Text="Outils" FontSize="16" FontWeight="Bold" Margin="20,0,0,16"
                           Foreground="{StaticResource BrushTextSecondary}" />

                <ListBox ItemsSource="{Binding ToolItems}"
                         SelectedItem="{Binding SelectedToolItem}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,2" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" Background="Transparent" CornerRadius="6">
                                            <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushBackground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                            <TextBlock Text="{Binding Title}" FontSize="13" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentToolPage}" />
    </Grid>
</UserControl>

<UserControl x:Class="V0XCleaner.App.Views.UninstallManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:V0XCleaner.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Désinstalleur" FontSize="24" FontWeight="Bold" />
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Programmes classiques et applications du Microsoft Store installés sur cet ordinateur." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Actualiser" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RefreshCommand}" MinWidth="110" Margin="0,0,12,0" />

            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="8,4"
                     Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}" />

            <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                      Margin="12,0,0,0" VerticalContentAlignment="Center" />

            <Button Grid.Column="4" Content="Exporter en CSV" Click="ExportCsvButton_Click"
                    Margin="12,0,0,0" Padding="14,6" />
        </Grid>

        <DataGrid Grid.Row="2" ItemsSource="{Binding DisplayedPrograms}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding DisplayName}" Width="2*" />
                <DataGridTextColumn Header="Version" Binding="{Binding DisplayVersion}" Width="*" />
                <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="1.5*" />
                <DataGridTextColumn Header="Taille" Binding="{Binding FormattedSize}" Width="90" />
                <DataGridTextColumn Header="Installé le" Binding="{Binding FormattedInstallDate}" Width="100" />
                <DataGridTextColumn Header="Type" Binding="{Binding KindLabel}" Width="140" />
                <DataGridTemplateColumn Header="Actions" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:InstalledProgramViewModel}">
                            <StackPanel Margin="4">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Désinstaller" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                            IsEnabled="{Binding CanUninstall}"
                                            Click="UninstallButton_Click" Tag="{Binding}" />
                                    <Button Content="Forcer" Padding="8,3" FontSize="11"
                                            ToolTip="Supprimer directement le dossier et l'entrée de registre, sans lancer le désinstalleur"
                                            Visibility="{Binding IsWin32, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Click="ForceRemoveButton_Click" Tag="{Binding}" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,16,0,0" />
    </Grid>
</UserControl>

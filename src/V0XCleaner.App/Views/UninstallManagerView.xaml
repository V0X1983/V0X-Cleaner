<UserControl x:Class="V0XCleaner.App.Views.UninstallManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:V0XCleaner.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Programme de désinstallation" FontSize="24" FontWeight="Bold" />
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Programmes classiques et applications du Microsoft Store installés sur cet ordinateur." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="8,4"
                     Background="{StaticResource BrushSurface}" Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}" ToolTip="Rechercher un programme" />

            <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                      Margin="12,0,0,0" VerticalContentAlignment="Center" />
        </Grid>

        <!-- En-têtes de colonnes -->
        <Grid Grid.Row="2" Margin="12,0,29,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                    Command="{Binding SortByNameCommand}" ToolTip="Trier par nom">
                <TextBlock Foreground="{StaticResource BrushTextSecondary}">
                    <Run Text="Programme" /><Run Text=" " /><Run Text="{Binding NameSortGlyph, Mode=OneWay}" />
                </TextBlock>
            </Button>
            <Button Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                    Command="{Binding SortBySizeCommand}" ToolTip="Trier par taille">
                <TextBlock Foreground="{StaticResource BrushTextSecondary}">
                    <Run Text="Taille" /><Run Text=" " /><Run Text="{Binding SizeSortGlyph, Mode=OneWay}" />
                </TextBlock>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DisplayedPrograms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:InstalledProgramViewModel}">
                        <Border Background="{StaticResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10"
                                Loaded="ProgramRow_Loaded">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Désinstaller" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                IsEnabled="{Binding CanUninstall}" Click="UninstallButton_Click" Tag="{Binding}" />
                                        <Button Content="Déplacer" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                ToolTip="Déplacer le dossier d'installation vers un autre dossier ou disque (une jonction est laissée à l'ancien emplacement)"
                                                Visibility="{Binding CanMove, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="MoveButton_Click" Tag="{Binding}" />
                                        <Button Content="Forcer" Padding="8,3" FontSize="11"
                                                ToolTip="Supprimer directement le dossier et l'entrée de registre, sans lancer le désinstalleur"
                                                Visibility="{Binding IsWin32, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="ForceRemoveButton_Click" Tag="{Binding}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" MaxWidth="200"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding FormattedSize}" VerticalAlignment="Center" Width="80" TextAlignment="Right"
                                           Foreground="{StaticResource BrushAccent}" />
                                <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="8">
                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                    </Border>
                                    <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding DetailsLine}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Barre du bas -->
        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushBorder}" Margin="0,16,0,0" Padding="0,16,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Exporter en CSV" Click="ExportCsvButton_Click" Margin="0,0,12,0" Padding="14,6" />
                    <Button Content="Actualiser" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" MinWidth="110" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="V0XCleaner.App.Views.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Width" Value="270" />
        </Style>
        <Style x:Key="TileValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="TileLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Accueil" FontSize="24" FontWeight="Bold" />
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"
                       Text="Vue d'ensemble de l'état de votre PC." />
        </StackPanel>

        <WrapPanel Grid.Row="1">
            <Border Style="{StaticResource TileStyle}">
                <StackPanel>
                    <TextBlock Text="Score de santé" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{Binding HealthScoreText}" Style="{StaticResource TileValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileStyle}">
                <StackPanel>
                    <TextBlock Text="Espace récupérable" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{Binding ReclaimableText}" Style="{StaticResource TileValueStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileStyle}">
                <StackPanel>
                    <TextBlock Text="Dernier nettoyage" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{Binding LastCleanText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushAccent}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource TileStyle}">
                <StackPanel>
                    <TextBlock Text="Corbeille de sécurité" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{Binding QuarantineText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushAccent}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="Actualiser" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" MinWidth="120" />
        </StackPanel>
    </Grid>
</UserControl>

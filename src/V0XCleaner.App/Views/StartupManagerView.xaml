<UserControl x:Class="V0XCleaner.App.Views.StartupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:V0XCleaner.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Démarrage" FontSize="24" FontWeight="Bold" />
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Programmes lancés à l'ouverture de session (registre, dossier Démarrage, tâches planifiées). Décocher désactive l'entrée sans la supprimer, comme dans le Gestionnaire des tâches." />
        </StackPanel>

        <Button Grid.Row="1" Content="Actualiser" Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding RefreshCommand}" HorizontalAlignment="Left" MinWidth="120" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StartupGroupViewModel}">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccent}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupEntryViewModel}">
                                        <Border Background="{StaticResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10"
                                                Visibility="{Binding IsDeleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <Grid IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                                          VerticalAlignment="Top" Margin="0,2,12,0" ToolTip="Activé au démarrage" />

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Command}" FontSize="11"
                                                               Foreground="{StaticResource BrushTextSecondary}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Location}" FontSize="10"
                                                               Foreground="{StaticResource BrushTextSecondary}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" Opacity="0.7" />
                                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                                               Foreground="{StaticResource BrushDanger}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" VerticalAlignment="Top"
                                                           FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,12,0" />

                                                <Button Grid.Column="3" Content="Supprimer" VerticalAlignment="Top"
                                                        Padding="10,4" FontSize="11"
                                                        Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,16,0,0" />
    </Grid>
</UserControl>

<UserControl x:Class="V0XCleaner.App.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:V0XCleaner.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Analyseur de disque" FontSize="24" FontWeight="Bold" />
            <TextBlock Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Parcourez un lecteur pour voir quels dossiers et fichiers occupent le plus d'espace." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                      MinWidth="90" VerticalContentAlignment="Center" Margin="0,0,12,0" />

            <Button Grid.Column="1" Content="↑ Remonter" Padding="10,5" IsEnabled="{Binding CanGoUp}"
                    Command="{Binding GoUpCommand}" Margin="0,0,12,0" />

            <TextBlock Grid.Column="2" Text="{Binding CurrentPath}" VerticalAlignment="Center"
                       Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Nodes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FolderSizeNodeViewModel}">
                        <Border Background="{StaticResource BrushSurface}" CornerRadius="6" Margin="0,0,0,4" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Node.FullPath}">
                                    <TextBlock.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                    </TextBlock.InputBindings>
                                </TextBlock>

                                <Border Grid.Column="1" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Background="{StaticResource BrushAccent}" CornerRadius="3"
                                        Width="{Binding BarFraction, Converter={StaticResource FractionToWidthConverter}, ConverterParameter=200}" />

                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" Margin="0,0,10,0" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="Explorer" Padding="8,3" FontSize="11" Margin="0,0,4,0"
                                            Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Supprimer" Padding="8,3" FontSize="11"
                                            Click="DeleteButton_Click" Tag="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,16,0,0" />
    </Grid>
</UserControl>

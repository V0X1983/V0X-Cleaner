<UserControl x:Class="V0XCleaner.App.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BrushBackground}"
          Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Width="200" Height="200" HorizontalAlignment="Center">
                <Ellipse Stroke="{DynamicResource BrushBorder}" StrokeThickness="4" Margin="2" />
                <Ellipse x:Name="Arc" Stroke="{DynamicResource BrushAccent}" StrokeThickness="4" Margin="2"
                         StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="ArcRotation" Angle="-90" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <StackPanel x:Name="PercentPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="PercentText" FontSize="44" FontWeight="Bold" />
                    <TextBlock Text="%" FontSize="22" FontWeight="Bold" VerticalAlignment="Bottom" Margin="2,0,0,8" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Message}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="520" Margin="0,28,0,24" />

            <Button Content="{Binding StopLabel}" Command="{Binding StopCommand}" HorizontalAlignment="Center" Padding="26,10"
                    Visibility="{Binding CanStop, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>

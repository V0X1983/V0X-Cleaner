<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Palette V0X Cleaner (identité propre). Les deux jeux de clés (Dark/Light) portent les
      mêmes noms que l'ancienne app WPF (Resources/Themes/Dark.xaml, Light.xaml) ; ici la bascule
      clair/sombre se fait via le mécanisme natif WinUI 3 (ThemeDictionaries + ElementTheme),
      il n'y a plus besoin d'un ThemeManager qui recharge un ResourceDictionary à la main.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ColorBackground">#FF141821</Color>
            <Color x:Key="ColorSurface">#FF1C2130</Color>
            <Color x:Key="ColorSurfaceAlt">#FF232939</Color>
            <Color x:Key="ColorBorder">#FF2E3646</Color>
            <Color x:Key="ColorAccent">#FF3DDC97</Color>
            <Color x:Key="ColorAccentHover">#FF33C287</Color>
            <Color x:Key="ColorTextPrimary">#FFEAECEF</Color>
            <Color x:Key="ColorTextSecondary">#FF9AA4B2</Color>
            <Color x:Key="ColorDanger">#FFE0555A</Color>
            <Color x:Key="ColorWarning">#FFE0A73D</Color>

            <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
            <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
            <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
            <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
            <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
            <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
            <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
            <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
            <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />

            <!-- Surcharge des clés de thème du TextBox natif WinUI (pas de retemplating, voir Controls.xaml). -->
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource ColorSurfaceAlt}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource ColorSurfaceAlt}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource ColorSurfaceAlt}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource ColorBorder}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource ColorBorder}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource ColorAccent}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource ColorTextSecondary}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource ColorTextSecondary}" />
            <SolidColorBrush x:Key="TextControlHeaderForeground" Color="{StaticResource ColorTextSecondary}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="ColorBackground">#FFF5F6F8</Color>
            <Color x:Key="ColorSurface">#FFFFFFFF</Color>
            <Color x:Key="ColorSurfaceAlt">#FFEBEDF0</Color>
            <Color x:Key="ColorBorder">#FFD8DCE2</Color>
            <Color x:Key="ColorAccent">#FF1F9D6B</Color>
            <Color x:Key="ColorAccentHover">#FF188056</Color>
            <Color x:Key="ColorTextPrimary">#FF1B1F27</Color>
            <Color x:Key="ColorTextSecondary">#FF5B6472</Color>
            <Color x:Key="ColorDanger">#FFC63B40</Color>
            <Color x:Key="ColorWarning">#FFAD7A16</Color>

            <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
            <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
            <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
            <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
            <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
            <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
            <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
            <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
            <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />

            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource ColorSurfaceAlt}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource ColorSurfaceAlt}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource ColorSurfaceAlt}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource ColorBorder}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource ColorBorder}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource ColorAccent}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource ColorTextSecondary}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource ColorTextSecondary}" />
            <SolidColorBrush x:Key="TextControlHeaderForeground" Color="{StaticResource ColorTextSecondary}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>

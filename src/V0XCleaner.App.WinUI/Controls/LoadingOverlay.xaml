<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="V0XCleaner.App.WinUI.Controls.LoadingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Name="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ArcRotation" Storyboard.TargetProperty="Angle"
                             From="-90" To="270" Duration="0:0:1.2" />
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{ThemeResource BrushBackground}"
          Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Width="200" Height="200" HorizontalAlignment="Center">
                <Ellipse Stroke="{ThemeResource BrushBorder}" StrokeThickness="4" Margin="2" />
                <Ellipse x:Name="Arc" Stroke="{ThemeResource BrushAccent}" StrokeThickness="4" Margin="2"
                         StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="ArcRotation" Angle="-90" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <StackPanel x:Name="PercentPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="PercentText" FontSize="44" FontWeight="Bold" Foreground="{ThemeResource BrushTextPrimary}" />
                    <TextBlock Text="%" FontSize="22" FontWeight="Bold" VerticalAlignment="Bottom" Margin="2,0,0,8"
                               Foreground="{ThemeResource BrushTextPrimary}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Message}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="520" Margin="0,28,0,24" Foreground="{ThemeResource BrushTextPrimary}" />

            <Button Content="{Binding StopLabel}" Command="{Binding StopCommand}" HorizontalAlignment="Center" Padding="26,10"
                    Visibility="{Binding CanStop, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>

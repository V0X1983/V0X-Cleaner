<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="V0XCleaner.App.WinUI.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{ThemeResource BrushSurface}" BorderBrush="{ThemeResource BrushBorder}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,24">
                <TextBlock Text="Outils" FontSize="16" FontWeight="Bold" Margin="20,0,0,16"
                           Foreground="{ThemeResource BrushTextSecondary}" />

                <ListView x:Name="ToolList" ItemsSource="{Binding ToolItems}"
                          SelectionChanged="ToolList_SelectionChanged"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="13" Margin="4,0" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <Frame Grid.Column="1" x:Name="ToolFrame" />
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="V0XCleaner.App.WinUI.Pages.StartupManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Ligne partagée par les onglets « applications » et « tâches planifiées » -->
        <DataTemplate x:Key="StartupRowTemplate">
            <Border Background="{ThemeResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10"
                    Visibility="{Binding IsDeleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{ThemeResource BrushDanger}" TextWrapping="Wrap"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Publisher}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="{Binding FilePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" ToolTipService.ToolTip="{Binding Location}" />
                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ToolTip="Activé au démarrage" />
                    <Button Grid.Column="4" Content="&#xE712;" FontFamily="Segoe Fluent Icons" Padding="8,3" FontSize="12"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="Plus d'actions"
                            Click="MoreButton_Click" Tag="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Ligne d'une entrée du menu contextuel -->
        <DataTemplate x:Key="ContextRowTemplate">
            <Border BorderBrush="{ThemeResource BrushBorder}" BorderThickness="0,0,0,1" Padding="28,10,12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{ThemeResource BrushDanger}" TextWrapping="Wrap"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Publisher}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="{Binding FilePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ToolTip="Afficher dans le menu contextuel" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Ligne d'un service Windows -->
        <DataTemplate x:Key="ServiceRowTemplate">
            <Border Background="{ThemeResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{ThemeResource BrushTextSecondary}" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{ThemeResource BrushDanger}" TextWrapping="Wrap"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Publisher}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="{Binding FilePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ToolTip="Démarrer avec Windows" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ContextGroupTemplate">
            <StackPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="12,10,0,10">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="16"
                               Foreground="{ThemeResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource ContextRowTemplate}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Gestionnaire de démarrage" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <RadioButton Style="{StaticResource TabStyle}" GroupName="startupTabs" Content="{Binding AppsTabTitle}" IsChecked="{Binding IsAppsTab, Mode=TwoWay}" />
            <RadioButton Style="{StaticResource TabStyle}" GroupName="startupTabs" Content="{Binding TasksTabTitle}" IsChecked="{Binding IsTasksTab, Mode=TwoWay}" />
            <RadioButton Style="{StaticResource TabStyle}" GroupName="startupTabs" Content="{Binding ContextTabTitle}" IsChecked="{Binding IsContextTab, Mode=TwoWay}" />
            <RadioButton Style="{StaticResource TabStyle}" GroupName="startupTabs" Content="{Binding ServicesTabTitle}" IsChecked="{Binding IsServicesTab, Mode=TwoWay}" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{ThemeResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,20,0,20">
            <StackPanel>
                <TextBlock Text="{Binding Headline}" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding HeadlineDescription}" Foreground="{ThemeResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- En-têtes de colonnes -->
        <Grid Grid.Row="3" Margin="12,0,29,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Programme" Foreground="{ThemeResource BrushTextSecondary}" />
            <TextBlock Grid.Column="1" Text="Éditeur" Foreground="{ThemeResource BrushTextSecondary}" />
            <TextBlock Grid.Column="2" Text="Chemin d'accès au fichier" Foreground="{ThemeResource BrushTextSecondary}" />
            <TextBlock Grid.Column="3" Text="{Binding ToggleColumnHeaderText}" HorizontalAlignment="Center" Foreground="{ThemeResource BrushTextSecondary}" />
        </Grid>

        <Grid Grid.Row="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsAppsTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource StartupRowTemplate}" />
            </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsTasksTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource StartupRowTemplate}" />
            </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsContextTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding ContextGroups}" ItemTemplate="{StaticResource ContextGroupTemplate}" />
            </ScrollViewer>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsServicesTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource ServiceRowTemplate}" />
            </ScrollViewer>
        </Grid>

        <!-- Barre du bas (WinUI n'a pas de DockPanel : Grid à deux colonnes équivalent) -->
        <Border Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource BrushBorder}" Margin="0,16,0,0" Padding="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{ThemeResource BrushTextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="Actualiser" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" MinWidth="120" />
            </Grid>
        </Border>
    </Grid>
</Page>

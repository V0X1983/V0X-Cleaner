<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="V0XCleaner.App.WinUI.Pages.DriveWiperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Effaceur de disque" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Foreground="{ThemeResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Remplit l'espace LIBRE d'un lecteur pour empêcher la récupération de fichiers déjà supprimés. Ne touche à aucun fichier existant." />
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource BrushSurfaceAlt}" BorderBrush="{ThemeResource BrushWarning}"
                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="⚠ À lire avant de continuer" FontWeight="Bold" Foreground="{ThemeResource BrushWarning}" Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource BrushTextPrimary}" FontSize="12" LineHeight="18">
                    Pendant l'opération, le lecteur choisi sera temporairement rempli à sa capacité maximale : les autres
                    applications peuvent échouer à écrire des fichiers ou afficher des avertissements "disque plein" tant
                    que l'effacement n'est pas terminé. N'éteignez pas l'ordinateur pendant l'opération. Selon la taille du
                    disque et la méthode choisie, cela peut prendre de quelques minutes à plusieurs heures.
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Lecteur :" VerticalAlignment="Center" Margin="0,0,12,8"
                       Foreground="{ThemeResource BrushTextSecondary}" />
            <ComboBox x:Name="DriveComboBox" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                      HorizontalAlignment="Left" MinWidth="120" Margin="0,0,0,8"
                      IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Méthode :" VerticalAlignment="Top" Margin="0,4,12,0"
                       Foreground="{ThemeResource BrushTextSecondary}" />
            <StackPanel Grid.Row="1" Grid.Column="1">
                <ComboBox ItemsSource="{Binding MethodOptions}" SelectedItem="{Binding SelectedMethod, Mode=TwoWay}"
                          HorizontalAlignment="Left" MinWidth="220"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}" />
                <TextBlock Text="{Binding SelectedMethod.Description}" FontSize="11" Foreground="{ThemeResource BrushTextSecondary}"
                           TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="480" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Effacer l'espace libre" Style="{StaticResource PrimaryButtonStyle}"
                    Click="StartButton_Click" IsEnabled="{Binding CanStartNow}" MinWidth="170" Margin="0,0,12,0" />

            <Button Grid.Column="1" Content="Annuler" Padding="14,8" Command="{Binding CancelCommand}" MinWidth="100" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="10" Width="260" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding PassLabel}" FontSize="11" Foreground="{ThemeResource BrushTextSecondary}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4" VerticalAlignment="Top" Text="{Binding StatusMessage}" Foreground="{ThemeResource BrushTextSecondary}" />
    </Grid>
</Page>

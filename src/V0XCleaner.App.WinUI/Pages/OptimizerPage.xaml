<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="V0XCleaner.App.WinUI.Pages.OptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Point d'impact : les 2e/3e points sont dupliqués (allumé/éteint) plutôt qu'un Style.Triggers
             (inexistant en WinUI) — chaque variante garde son ThemeResource correct quel que soit le thème. -->
        <DataTemplate x:Key="ImpactTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,4,0" Fill="{ThemeResource BrushWarning}" />
                <Grid Width="8" Height="8" Margin="0,0,4,0">
                    <Ellipse Fill="{ThemeResource BrushWarning}" Visibility="{Binding Dot2On, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Ellipse Fill="{ThemeResource BrushBorder}" Visibility="{Binding Dot2On, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
                <Grid Width="8" Height="8" Margin="0,0,4,0">
                    <Ellipse Fill="{ThemeResource BrushWarning}" Visibility="{Binding Dot3On, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Ellipse Fill="{ThemeResource BrushBorder}" Visibility="{Binding Dot3On, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
                <TextBlock Text="{Binding ImpactText}" Margin="8,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ActiveRowTemplate">
            <Border Background="{ThemeResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{ThemeResource BrushTextSecondary}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="2" Margin="24,0,0,0" Content="{Binding}" ContentTemplate="{StaticResource ImpactTemplate}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Mettre en veille" Padding="8,3" FontSize="11" Margin="0,0,8,0"
                                Click="SleepButton_Click" Tag="{Binding}" />
                        <Button Content="&#xE712;" FontFamily="Segoe Fluent Icons" Padding="8,3" FontSize="12"
                                ToolTipService.ToolTip="Plus d'actions" Click="MoreButton_Click" Tag="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SleepingRowTemplate">
            <Border Background="{ThemeResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{ThemeResource BrushTextSecondary}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="2" Margin="24,0,0,0" Content="{Binding}" ContentTemplate="{StaticResource ImpactTemplate}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Réactiver" Padding="8,3" FontSize="11" Margin="0,0,8,0"
                                Click="ResumeButton_Click" Tag="{Binding}" />
                        <Button Content="&#xE712;" FontFamily="Segoe Fluent Icons" Padding="8,3" FontSize="12"
                                ToolTipService.ToolTip="Plus d'actions" Click="MoreButton_Click" Tag="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Optimiseur de performances" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <RadioButton Style="{StaticResource TabStyle}" GroupName="optimizerTabs" Content="{Binding ActiveTabTitle}" IsChecked="{Binding IsActiveTab, Mode=TwoWay}" />
            <RadioButton Style="{StaticResource TabStyle}" GroupName="optimizerTabs" Content="{Binding SleepingTabTitle}" IsChecked="{Binding IsSleepingTab, Mode=TwoWay}" />
            <RadioButton Style="{StaticResource TabStyle}" GroupName="optimizerTabs" Content="{Binding ExcludedTabTitle}" IsChecked="{Binding IsExcludedTab, Mode=TwoWay}" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{ThemeResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,20,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding HeadlinePrefix}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="{Binding HeadlineCount}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource BrushWarning}" />
                    <TextBlock Text="{Binding HeadlineSuffix}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
                <TextBlock Text="{Binding HeadlineDescription}" Foreground="{ThemeResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- En-têtes de colonnes -->
        <Grid Grid.Row="3" Margin="12,0,29,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding ColumnHeaderText}" Foreground="{ThemeResource BrushTextSecondary}" />
            <TextBlock Grid.Column="1" Text="Mémoire" HorizontalAlignment="Right" Foreground="{ThemeResource BrushTextSecondary}"
                       Visibility="{Binding IsExcludedTab, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            <TextBlock Grid.Column="2" Text="Impact sur les performances" Margin="24,0,0,0" Foreground="{ThemeResource BrushTextSecondary}"
                       Visibility="{Binding IsExcludedTab, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </Grid>

        <Grid Grid.Row="4">
            <!-- Onglet « actives » -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsActiveTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Processes}" ItemTemplate="{StaticResource ActiveRowTemplate}" />
            </ScrollViewer>

            <!-- Onglet « en veille » -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSleepingTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Sleeping}" ItemTemplate="{StaticResource SleepingRowTemplate}" />
            </ScrollViewer>

            <!-- Onglet « exclues » -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsExcludedTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Excluded}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Réinclure" Padding="8,3" FontSize="11" VerticalAlignment="Center"
                                            Click="IncludeButton_Click" Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Barre du bas (WinUI n'a pas de DockPanel : Grid équivalent) -->
        <Border Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource BrushBorder}" Margin="0,16,0,0" Padding="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{ThemeResource BrushTextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding LastAnalysisText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="2" Content="Libérer la RAM" Command="{Binding FreeMemoryCommand}" Margin="0,0,12,0" />
                <Button Grid.Column="3" Content="Analyser à nouveau" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>
    </Grid>
</Page>

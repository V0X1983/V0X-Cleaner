<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="V0XCleaner.App.WinUI.Pages.DuplicateFinderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:V0XCleaner.App.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Doublons" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Foreground="{ThemeResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Recherche les fichiers strictement identiques (même taille, même contenu) dans un dossier. Une copie de chaque groupe reste cochée par défaut : décochez-la aussi si vous voulez tout supprimer." />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding FolderPath, Mode=TwoWay}"
                         VerticalContentAlignment="Center" Padding="8,4" Margin="0,0,12,0" />

                <Button Grid.Column="1" Content="Parcourir..." Padding="12,6" Click="BrowseButton_Click" Margin="0,0,12,0" />

                <Button Grid.Column="2" Content="Analyser" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ScanCommand}" MinWidth="110" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Supprimer les fichiers cochés" Click="DeleteSelectedButton_Click"
                        IsEnabled="{Binding CanDeleteNow}" Padding="12,6" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{ThemeResource BrushAccent}" FontWeight="SemiBold"
                           Text="{Binding SelectedLabel}" />
            </Grid>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource BrushSurface}" CornerRadius="6" Margin="0,0,0,10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,6">
                                        <Run Text="{Binding Entries.Count}" FontWeight="SemiBold" />
                                        <Run Text=" copies · " Foreground="{ThemeResource BrushTextSecondary}" />
                                        <Run Text="{Binding FormattedSize}" Foreground="{ThemeResource BrushTextSecondary}" />
                                        <Run Text=" chacune · gaspillage : " Foreground="{ThemeResource BrushTextSecondary}" />
                                        <Run Text="{Binding FormattedWasted}" Foreground="{ThemeResource BrushAccent}" FontWeight="SemiBold" />
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2" Content="{Binding FilePath}"
                                                          Foreground="{ThemeResource BrushTextPrimary}" FontSize="12" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="{ThemeResource BrushTextSecondary}" Margin="0,16,0,0" />
        </Grid>
        <controls:LoadingOverlay DataContext="{Binding Loading}" />
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="V0XCleaner.App.WinUI.Pages.HealthCheckPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:V0XCleaner.App.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="HealthCategoryTemplate">
            <Border Background="{ThemeResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="20"
                               Foreground="{ThemeResource BrushAccent}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Foreground="{ThemeResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding CountText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HealthProblemTemplate">
            <Border Background="{ThemeResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="20"
                               Foreground="{ThemeResource BrushWarning}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Foreground="{ThemeResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{ThemeResource BrushWarning}" FontWeight="SemiBold" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Accueil : présentation et bouton d'analyse -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                        Visibility="{Binding IsIntro, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Bilan de santé" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Foreground="{ThemeResource BrushTextSecondary}" Margin="0,8,0,20" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Analysez votre PC en trois étapes : confidentialité, espace disque puis problèmes à résoudre. Rien n'est supprimé sans que vous l'ayez validé." />
                <Button Content="Analyser" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AnalyzeCommand}"
                        HorizontalAlignment="Center" MinWidth="160" Padding="16,10" />
                <Button Content="Libérer la RAM" Command="{Binding FreeMemoryCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource BrushTextSecondary}" Margin="0,16,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>

            <!-- Indicateur des trois étapes -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24"
                        Visibility="{Binding IsStarted, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Width="170">
                    <Grid Width="26" Height="26" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{ThemeResource BrushTextSecondary}" />
                        <Ellipse Width="10" Height="10" Fill="{ThemeResource BrushAccent}" Visibility="{Binding Step1Done, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="{ThemeResource BrushWarning}"
                                Background="{ThemeResource BrushBackground}" Visibility="{Binding Step1Current, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="!" FontWeight="Bold" Foreground="{ThemeResource BrushWarning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="Plus de confidentialité" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
                <Border Width="90" Height="2" Margin="0,12,0,0" VerticalAlignment="Top" Background="{ThemeResource BrushBorder}" />
                <StackPanel Width="170">
                    <Grid Width="26" Height="26" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{ThemeResource BrushTextSecondary}" />
                        <Ellipse Width="10" Height="10" Fill="{ThemeResource BrushAccent}" Visibility="{Binding Step2Done, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="{ThemeResource BrushWarning}"
                                Background="{ThemeResource BrushBackground}" Visibility="{Binding Step2Current, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="!" FontWeight="Bold" Foreground="{ThemeResource BrushWarning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="Plus d'espace" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
                <Border Width="90" Height="2" Margin="0,12,0,0" VerticalAlignment="Top" Background="{ThemeResource BrushBorder}" />
                <StackPanel Width="170">
                    <Grid Width="26" Height="26" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{ThemeResource BrushTextSecondary}" />
                        <Border Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="{ThemeResource BrushWarning}"
                                Background="{ThemeResource BrushBackground}" Visibility="{Binding IsProblemsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="!" FontWeight="Bold" Foreground="{ThemeResource BrushWarning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="Résoudre les problèmes" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Étapes 1 et 2 : catégories à nettoyer -->
            <Grid Grid.Row="1" Visibility="{Binding IsCleaningStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="{Binding Headline}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="{Binding HeadlineDescription}" Foreground="{ThemeResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsThreeState="True" IsChecked="{Binding AllSelected, Mode=TwoWay}" VerticalAlignment="Center" ToolTipService.ToolTip="Tout sélectionner" />
                    <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="Catégorie" Foreground="{ThemeResource BrushTextSecondary}" />
                    <TextBlock Grid.Column="3" Text="Objets" HorizontalAlignment="Right" Foreground="{ThemeResource BrushTextSecondary}" />
                    <TextBlock Grid.Column="4" Text="Taille" HorizontalAlignment="Right" Foreground="{ThemeResource BrushTextSecondary}" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource HealthCategoryTemplate}" />
                </ScrollViewer>
            </Grid>

            <!-- Étape 3 : problèmes détectés -->
            <Grid Grid.Row="1" Visibility="{Binding IsProblemsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HeadlineHighlight}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource BrushWarning}" />
                            <TextBlock Text="{Binding HeadlineWithLeadingSpace}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="{Binding HeadlineDescription}" Foreground="{ThemeResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- État du PC -->
                    <Border Grid.Column="1" Width="360" Padding="16,12" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource BrushBorder}"
                            Background="{ThemeResource BrushSurface}" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="État du PC : " FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PcStateText}" FontWeight="SemiBold" Foreground="{ThemeResource BrushWarning}" />
                            </StackPanel>
                            <TextBlock Text="{Binding PcStateAdvice}" Foreground="{ThemeResource BrushTextSecondary}" Margin="0,4,0,8" TextWrapping="Wrap" />
                            <Grid Height="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{ThemeResource BrushDanger}" CornerRadius="3,0,0,3" Height="6" />
                                <Border Grid.Column="1" Background="{ThemeResource BrushWarning}" Height="6" />
                                <Border Grid.Column="2" Background="{ThemeResource BrushAccent}" CornerRadius="0,3,3,0" Height="6" />
                            </Grid>
                            <!-- Style.Triggers/DataTrigger WPF (inexistant en WinUI) remplacé par deux TextBlock par
                                 libellé (gras+primaire quand actif / normal+secondaire sinon) pour garder les
                                 ThemeResource corrects quel que soit le thème. -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Médiocre" FontSize="11" Foreground="{ThemeResource BrushTextSecondary}"
                                           Visibility="{Binding IsPcStatePoor, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <TextBlock Grid.Column="0" Text="Médiocre" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource BrushTextPrimary}"
                                           Visibility="{Binding IsPcStatePoor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Grid.Column="1" Text="Modéré" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource BrushTextSecondary}"
                                           Visibility="{Binding IsPcStateModerate, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <TextBlock Grid.Column="1" Text="Modéré" FontSize="11" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{ThemeResource BrushTextPrimary}"
                                           Visibility="{Binding IsPcStateModerate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Grid.Column="2" Text="Bon état" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource BrushTextSecondary}"
                                           Visibility="{Binding IsPcStateGood, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <TextBlock Grid.Column="2" Text="Bon état" FontSize="11" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{ThemeResource BrushTextPrimary}"
                                           Visibility="{Binding IsPcStateGood, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="Catégorie" Foreground="{ThemeResource BrushTextSecondary}" />
                    <TextBlock Grid.Column="2" Text="Problèmes" HorizontalAlignment="Right" Foreground="{ThemeResource BrushTextSecondary}" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource HealthProblemTemplate}" />
                </ScrollViewer>
            </Grid>

            <!-- Barre du bas (WinUI n'a pas de DockPanel : Grid équivalent) -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource BrushBorder}" Margin="0,16,0,0" Padding="0,16,0,0"
                    Visibility="{Binding IsStarted, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{ThemeResource BrushTextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsCleaningStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="Ces articles peuvent être retirés en toute sécurité" Foreground="{ThemeResource BrushTextSecondary}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button Content="Ignorer" Command="{Binding NextCommand}" MinWidth="90" Margin="0,0,12,0" />
                        <Button Content="Nettoyer" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanCleanSelection}" MinWidth="110"
                                Click="CleanButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsProblemsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="Libérer la RAM" Command="{Binding FreeMemoryCommand}" Margin="0,0,12,0" />
                        <Button Content="Nouvelle analyse" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AnalyzeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <controls:LoadingOverlay DataContext="{Binding Loading}" />
    </Grid>
</Page>

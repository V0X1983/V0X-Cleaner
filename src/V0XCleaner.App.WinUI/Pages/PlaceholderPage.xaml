<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="V0XCleaner.App.WinUI.Pages.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Margin="32" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />
        <TextBlock x:Name="DescriptionText" FontSize="14" Foreground="{ThemeResource BrushTextSecondary}"
                   TextWrapping="Wrap" />
    </StackPanel>
</Page>

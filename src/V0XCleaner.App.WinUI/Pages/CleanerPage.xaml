<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="V0XCleaner.App.WinUI.Pages.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:V0XCleaner.App.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="CleaningTaskTemplate">
            <Border Background="{ThemeResource BrushSurface}" CornerRadius="6" Margin="0,0,0,6" Padding="12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Foreground="{ThemeResource BrushTextSecondary}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding LastError}" Foreground="{ThemeResource BrushDanger}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding LastError, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CleaningSectionTemplate">
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{ThemeResource BrushAccent}" Margin="12,0,0,10" />
                <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource CleaningTaskTemplate}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid Margin="32,24,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Nettoyage personnalisé" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Choisissez les catégories à analyser, puis nettoyez ce qui a été trouvé."
                           Foreground="{ThemeResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- En-têtes de colonnes -->
            <Grid Grid.Row="1" Margin="12,0,29,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Catégorie" Foreground="{ThemeResource BrushTextSecondary}" />
                <TextBlock Grid.Column="2" Text="Taille" HorizontalAlignment="Right" Foreground="{ThemeResource BrushTextSecondary}" />
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource CleaningSectionTemplate}" />
            </ScrollViewer>

            <!-- Barre du bas (WinUI n'a pas de DockPanel : Grid équivalent) -->
            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource BrushBorder}" Margin="0,16,0,0" Padding="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RecoverableLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource BrushTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="Mode simulation (aperçu sans suppression)" IsChecked="{Binding SimulationMode, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{ThemeResource BrushTextSecondary}" />
                    <Button Grid.Column="2" Content="Analyser" Command="{Binding AnalyzeCommand}" MinWidth="110" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="Nettoyer" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanCleanNow}"
                            Click="CleanButton_Click" MinWidth="120" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
        <controls:LoadingOverlay DataContext="{Binding Loading}" />
    </Grid>
</Page>

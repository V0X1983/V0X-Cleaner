<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="V0XCleaner.App.WinUI.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Aide" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{Binding VersionText}" Foreground="{ThemeResource BrushTextSecondary}" Margin="0,4,0,20" />

            <Border Background="{ThemeResource BrushSurface}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Bien démarrer" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{ThemeResource BrushTextSecondary}"
                               Text="1. Ouvrez Nettoyeur, cliquez sur Analyser puis Exécuter le nettoyage (activez d'abord le mode simulation pour un aperçu).&#x0a;2. Les fichiers nettoyés vont dans Outils › Corbeille de sécurité : vous pouvez les restaurer pendant 7 jours.&#x0a;3. Registre : une sauvegarde .reg est créée avant toute réparation et restaurable.&#x0a;4. Certaines actions (clés HKLM, points de restauration) exigent « Relancer en administrateur » dans le menu latéral." />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource BrushSurface}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Dépannage" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource BrushTextSecondary}" Margin="0,0,0,12"
                               Text="En cas de problème, consultez les journaux ou le dossier de données (paramètres, sauvegardes, quarantaine)." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Ouvrir les journaux" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,10,0" />
                        <Button Content="Ouvrir le dossier de données" Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
